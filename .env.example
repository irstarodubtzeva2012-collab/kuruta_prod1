# ─────────────────────────────────────────────────────────────────
# KURUTA — Environment Variables
# Скопируйте в .env и заполните значения для локальной разработки
# ─────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────
DATABASE_URL="postgresql://kuruta:kuruta_dev@localhost:5432/kuruta?schema=public"
POSTGRES_USER=kuruta
POSTGRES_PASSWORD=kuruta_dev
POSTGRES_DB=kuruta
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL="redis://:kuruta_dev@localhost:6379"
REDIS_PASSWORD=kuruta_dev
REDIS_PORT=6379

# ─── S3 / MinIO ──────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY=kuruta_minio
S3_SECRET_KEY=kuruta_minio_secret
S3_BUCKET=kuruta-uploads
S3_REGION=us-east-1
S3_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── JWT ──────────────────────────────────────────────────────────
# Сгенерируйте: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_access_secret_64_chars_min"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret_64_chars_min"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── 2FA / TOTP ──────────────────────────────────────────────────
TOTP_ISSUER=KURUTA

# ─── App ──────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000

# ─── Payments (adapter — stub for dev) ────────────────────────────
PAYMENT_PROVIDER=stub
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=

# ─── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@kuruta.dev

# ─── Sentry ───────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── Min withdrawal ──────────────────────────────────────────────
MIN_WITHDRAWAL_AMOUNT=500
