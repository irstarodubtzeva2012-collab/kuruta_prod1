// ─────────────────────────────────────────────────────────────────
// KURUTA — Prisma Schema
// Единственная БД: PostgreSQL 16
// Конституция: KURUTA_CONTEXT.md
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────

enum UserRole {
  guest
  creator
  ambassador
  platform_owner
  moderator
  finance
  admin
  superadmin
}

enum UserStatus {
  active
  limited
  blocked
  deleted
}

enum AmbassadorVerificationStatus {
  draft
  pending
  needs_info
  approved
  rejected
  suspended
}

enum CampaignStatus {
  draft
  awaiting_payment
  pending_review
  approved
  active
  paused
  completed
  cancelled
}

enum TaskStatus {
  available
  taken
  in_progress
  proof_submitted
  reviewing
  approved
  paid
  rejected
  resubmit_required
  overdue
  cancelled
  disputed
}

enum AdSlotStatus {
  draft
  pending_review
  published
  booked
  in_progress
  confirming
  completed
  closed
}

enum DealStatus {
  created
  paid
  in_progress
  confirming
  completed
  disputed
  cancelled
}

enum PayoutStatus {
  requested
  checking
  processing
  paid
  error
  cancelled
}

enum DisputeStatus {
  opened
  investigating
  resolved_creator
  resolved_executor
  resolved_partial
  closed
}

enum ModerationQueueType {
  ambassador_verification
  platform_owner_verification
  campaign
  task
  deal
  dispute
  payout
}

enum ModerationQueueStatus {
  pending
  in_progress
  approved
  rejected
  needs_revision
}

enum FinancialTransactionType {
  deposit
  reserve
  release
  reward
  fee
  payout
  refund
  adjustment
}

enum FinancialTransactionStatus {
  pending
  completed
  failed
  refunded
}

enum NotificationType {
  task_assigned
  task_completed
  task_rejected
  payout_requested
  payout_processed
  dispute_opened
  dispute_resolved
  campaign_approved
  campaign_rejected
  deal_created
  deal_completed
  verification_approved
  verification_rejected
}

enum AntiFraudSignalType {
  duplicate_device_fingerprint
  duplicate_payout_requisites
  suspicious_fast_completion
  duplicate_proof_screenshots
  sudden_audience_growth
  unusual_activity_pattern
}

enum AntiFraudSignalSeverity {
  low
  medium
  high
  critical
}

// ─── User ─────────────────────────────────────────────────────────

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  phone         String?     @unique
  passwordHash  String
  status        UserStatus  @default(active)
  totpSecret    String?     // encrypted
  totpEnabled   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  profile       UserProfile?
  roles         UserRoleAssignment[]
  ambassadorProfile      AmbassadorProfile?
  platformOwnerProfile   PlatformOwnerProfile?
  campaigns     Campaign[]
  tasks         Task[]           @relation("TaskAmbassador")
  adSlots       AdSlot[]
  deals         Deal[]           @relation("DealBuyer")
  transactions  FinancialTransaction[]
  payouts       PayoutRequest[]
  disputes      Dispute[]        @relation("DisputeOpener")
  notifications Notification[]
  sessions      Session[]
  auditLogs     AuditLog[]
  antiFraudSignals AntiFraudSignal[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

// ─── UserProfile ──────────────────────────────────────────────────

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  displayName   String?
  avatarUrl     String?
  bio           String?
  country       String?
  city          String?
  timezone      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_profiles")
}

// ─── UserRoleAssignment (many-to-many) ────────────────────────────

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  role      UserRole
  grantedAt DateTime @default(now())
  grantedBy String?  // userId of admin who granted

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
  @@map("user_role_assignments")
}

// ─── AmbassadorProfile ───────────────────────────────────────────

model AmbassadorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  isVerified      Boolean  @default(false)
  socialLinks     Json?    // jsonb: { telegram, instagram, youtube, etc. }
  audienceSize    Int?
  niches          String[] // array
  languages       String[] // array
  avgEngagement   Decimal? @db.Decimal(5, 2) // percentage
  rating          Decimal? @db.Decimal(3, 2) // 0.00 - 5.00
  totalTasks      Int      @default(0)
  completedTasks  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications   AmbassadorVerificationRequest[]
  tasks           Task[]

  @@index([userId])
  @@index([isVerified])
  @@index([rating])
  @@map("ambassador_profiles")
}

// ─── AmbassadorVerificationRequest ───────────────────────────────

model AmbassadorVerificationRequest {
  id              String                       @id @default(uuid())
  ambassadorId    String
  status          AmbassadorVerificationStatus @default(draft)
  socialLinks     Json?                        // jsonb
  audienceProof   Json?                        // jsonb: screenshots, analytics
  niches          String[]
  documents       Json?                        // jsonb: uploaded files metadata
  reviewedBy      String?                      // moderator userId
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  ambassador      AmbassadorProfile            @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@index([ambassadorId])
  @@index([status])
  @@index([createdAt])
  @@map("ambassador_verification_requests")
}

// ─── PlatformOwnerProfile ────────────────────────────────────────

model PlatformOwnerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  isVerified      Boolean  @default(false)
  companyName     String?
  legalEntity     String?
  inn             String?  // Russian tax ID
  ogrn            String?  // Russian registration number
  contactEmail    String?
  contactPhone    String?
  rating          Decimal? @db.Decimal(3, 2)
  totalDeals      Int      @default(0)
  completedDeals  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platforms       Platform[]

  @@index([userId])
  @@index([isVerified])
  @@map("platform_owner_profiles")
}

// ─── Platform ────────────────────────────────────────────────────

model Platform {
  id              String   @id @default(uuid())
  ownerId         String
  name            String
  type            String   // telegram, instagram, youtube, vk, tiktok, etc.
  url             String
  audienceSize    Int
  audienceGeo     Json?    // jsonb: { "RU": 60, "US": 20, ... }
  audienceAge     Json?    // jsonb: { "18-24": 30, "25-34": 45, ... }
  description     String?
  mediaKit        Json?    // jsonb: additional info, stats
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           PlatformOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  adSlots         AdSlot[]

  @@index([ownerId])
  @@index([type])
  @@index([isVerified])
  @@map("platforms")
}

// ─── Campaign (Direction A) ──────────────────────────────────────

model Campaign {
  id              String          @id @default(uuid())
  creatorId       String
  title           String
  description     String
  status          CampaignStatus  @default(draft)
  budget          Decimal         @db.Decimal(14, 2)
  taskCount       Int
  taskReward      Decimal         @db.Decimal(14, 2)
  requirements    Json?           // jsonb: task requirements, guidelines
  targetAudience  Json?           // jsonb: demographics, interests
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  creator         User   @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  tasks           Task[]

  @@index([creatorId])
  @@index([status])
  @@index([createdAt])
  @@index([startsAt, endsAt])
  @@map("campaigns")
}

// ─── Task (Direction A) ──────────────────────────────────────────

model Task {
  id              String      @id @default(uuid())
  campaignId      String
  ambassadorId    String?
  status          TaskStatus  @default(available)
  title           String
  description     String
  requirements    Json?       // jsonb: specific requirements
  proofData       Json?       // jsonb: screenshots, links, etc.
  reviewNotes     String?
  reviewedBy      String?     // moderator userId
  reviewedAt      DateTime?
  takenAt         DateTime?
  submittedAt     DateTime?
  paidAt          DateTime?
  dueAt           DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ambassador      User?    @relation("TaskAmbassador", fields: [ambassadorId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([ambassadorId])
  @@index([status])
  @@index([createdAt])
  @@index([dueAt])
  @@index([campaignId, status])
  @@map("tasks")
}

// ─── AdSlot (Direction B) ────────────────────────────────────────

model AdSlot {
  id              String        @id @default(uuid())
  platformId      String
  ownerId         String        // denormalized for faster queries
  title           String
  description     String
  status          AdSlotStatus  @default(draft)
  pricePerDay     Decimal       @db.Decimal(14, 2)
  currency        String        @default("RUB")
  duration        String        // "1d", "3d", "7d", etc.
  format          String        // "post", "story", "reel", "video", etc.
  availability    Json?         // jsonb: calendar of available dates
  requirements    Json?         // jsonb: content requirements
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  platform        Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  deals           Deal[]

  @@index([platformId])
  @@index([ownerId])
  @@index([status])
  @@index([pricePerDay])
  @@index([createdAt])
  @@index([platformId, status])
  @@map("ad_slots")
}

// ─── Deal (Direction B) ──────────────────────────────────────────

model Deal {
  id              String      @id @default(uuid())
  adSlotId        String
  buyerId         String      // creator userId
  status          DealStatus  @default(created)
  startDate       DateTime
  endDate         DateTime
  totalAmount     Decimal     @db.Decimal(14, 2)
  commission      Decimal     @db.Decimal(14, 2) // 10%
  contentBrief    String?
  proofData       Json?       // jsonb: published content proof
  confirmedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  adSlot          AdSlot @relation(fields: [adSlotId], references: [id], onDelete: Restrict)
  buyer           User   @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([adSlotId])
  @@index([buyerId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([createdAt])
  @@index([adSlotId, status])
  @@map("deals")
}

// ─── FinancialTransaction (double-entry journal) ─────────────────

model FinancialTransaction {
  id                String                     @id @default(uuid())
  idempotencyKey    String                     @unique
  type              FinancialTransactionType
  userId            String
  amount            Decimal                    @db.Decimal(14, 2) // always positive
  currency          String                     @default("RUB")
  status            FinancialTransactionStatus @default(pending)
  relatedEntityType String?                    // campaign, task, ad_slot, deal, dispute, payout
  relatedEntityId   String?
  description       String?
  metadata          Json?                      // jsonb: additional data
  createdAt         DateTime                   @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([idempotencyKey])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([relatedEntityType, relatedEntityId])
  @@map("financial_transactions")
}

// ─── PayoutRequest ───────────────────────────────────────────────

model PayoutRequest {
  id              String        @id @default(uuid())
  userId          String
  amount          Decimal       @db.Decimal(14, 2)
  currency        String        @default("RUB")
  status          PayoutStatus  @default(requested)
  paymentMethod   String?       // card, sbp, crypto, etc.
  requisites      Json?         // jsonb: masked payment details
  processedBy     String?       // finance userId
  processedAt     DateTime?
  errorDetails    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@map("payout_requests")
}

// ─── ModerationQueue ─────────────────────────────────────────────

model ModerationQueue {
  id              String                 @id @default(uuid())
  entityType      ModerationQueueType
  entityId        String
  status          ModerationQueueStatus  @default(pending)
  priority        Int                    @default(0) // higher = more urgent
  assignedTo      String?                // moderator userId
  assignedAt      DateTime?
  reviewedAt      DateTime?
  decision        String?                // approved, rejected, needs_revision
  decisionReason  String?
  metadata        Json?                  // jsonb: context for moderator
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([entityType, entityId])
  @@index([status])
  @@index([priority, createdAt])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("moderation_queue")
}

// ─── Dispute ─────────────────────────────────────────────────────

model Dispute {
  id              String          @id @default(uuid())
  openedBy        String
  relatedType     String          // task, deal
  relatedId       String
  status          DisputeStatus   @default(opened)
  reason          String
  description     String?
  evidence        Json?           // jsonb: screenshots, messages, etc.
  resolution      String?
  resolvedBy      String?         // moderator userId
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  opener          User @relation("DisputeOpener", fields: [openedBy], references: [id], onDelete: Restrict)

  @@index([openedBy])
  @@index([relatedType, relatedId])
  @@index([status])
  @@index([createdAt])
  @@map("disputes")
}

// ─── AuditLog (append-only, NO updatedAt) ────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // e.g., "user.login", "transaction.create", "task.update"
  entityType  String
  entityId    String
  before      Json?    // jsonb: previous state
  after       Json?    // jsonb: new state
  ip          String?
  userAgent   String?
  timestamp   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@map("audit_log")
}

// ─── Notification ────────────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  data        Json?            // jsonb: deep link, entity refs
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

// ─── Session (refresh tokens) ────────────────────────────────────

model Session {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique // hashed
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── AntiFraudSignal ─────────────────────────────────────────────

model AntiFraudSignal {
  id            String                   @id @default(uuid())
  userId        String?
  type          AntiFraudSignalType
  severity      AntiFraudSignalSeverity
  title         String
  description   String
  metadata      Json?                    // jsonb: evidence, context
  reviewedBy    String?                  // moderator userId
  reviewedAt    DateTime?
  resolved      Boolean                  @default(false)
  resolution    String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user          User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@index([userId, type])
  @@map("anti_fraud_signals")
}
